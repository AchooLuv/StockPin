<Window x:Class="StockPin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPin"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="344"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="DirectionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource Up}" />
                </Trigger>
                <Trigger Property="Tag" Value="Down">
                    <Setter Property="Foreground" Value="{DynamicResource Down}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="16" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="0,0,0,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= header (drag handle) ================= -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="STOCKPIN" Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                    <TextBlock x:Name="LockGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                               Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed" ToolTip="面板位置已锁定" />
                </StackPanel>

                <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,4,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Opacity" Value="0.45" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <Setter Property="Opacity" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Style="{StaticResource IconButton}" Click="Refresh_Click" ToolTip="立即刷新">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Add_Click" ToolTip="添加股票">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Hide_Click" ToolTip="隐藏到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= simulated portfolio ================= -->
            <Border Grid.Row="1" x:Name="PortfolioBox" Margin="8,2,8,6" CornerRadius="10"
                    Background="{DynamicResource Surface}" Padding="10,8" ToolTip="{Binding FxTooltip}"
                    Visibility="{Binding HasPortfolio, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="持仓市值" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding PortfolioValueText}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="总盈亏" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding TotalPlText}" Tag="{Binding TotalPlDirection}"
                                   Style="{StaticResource DirectionText}" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,0,0">
                        <TextBlock Text="今日盈亏" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding TodayPlText}" Tag="{Binding TodayPctDirection}"
                                   Style="{StaticResource DirectionText}" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,6,0,0">
                        <TextBlock Text="今日涨跌幅" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Text="{Binding TodayPctText}" Tag="{Binding TodayPctDirection}"
                                   Style="{StaticResource DirectionText}" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= watch list ================= -->
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="StockScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Margin="0,0,0,2">
                    <ItemsControl ItemsSource="{Binding Stocks}" Margin="6,0,6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="8" Padding="7,0" Height="28"
                                        Background="Transparent" ToolTip="{Binding DetailText}"
                                        MouseRightButtonDown="StockRow_RightButtonDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource RowHover}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="16" Height="16" CornerRadius="4"
                                                Background="{DynamicResource ChipBg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TagText}" FontSize="9"
                                                       Foreground="{DynamicResource ChipText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="6,0,4,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="132" />
                                            <TextBlock Text="{Binding Code}" FontSize="9.5"
                                                       Foreground="{DynamicResource TextMuted}" Margin="5,1,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.ShowCode,
                                                           RelativeSource={RelativeSource AncestorType=Window},
                                                           Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="12.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   TextAlignment="Right" MinWidth="60" Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="3" Text="{Binding ChangePctText}"
                                                   Tag="{Binding DirectionText}" Style="{StaticResource DirectionText}"
                                                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextAlignment="Right" MinWidth="54" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,22,0,26"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="自选列表还是空的" FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                    <Button Content="＋ 添加股票" Style="{StaticResource PrimaryButton}" Height="30"
                            Width="112" Margin="0,10,0,0" Click="Add_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= status line ================= -->
            <Border Grid.Row="3" Margin="12,2,12,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
