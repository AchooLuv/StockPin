<Window x:Class="StockPin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPin"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="330"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="DirectionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Up">
                    <Setter Property="Foreground" Value="{DynamicResource Up}" />
                </Trigger>
                <Trigger Property="Tag" Value="Down">
                    <Setter Property="Foreground" Value="{DynamicResource Down}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StockToolTipStyle" TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource TooltipBg}"
                                BorderBrush="{DynamicResource TooltipBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelIconButton" TargetType="Button">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="StockRowTemplate">
            <Grid Height="26" Background="Transparent"
                  MouseRightButtonDown="StockRow_RightButtonDown">
                <Grid.ToolTip>
                    <ToolTip Style="{StaticResource StockToolTipStyle}"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <StackPanel Width="228">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Code}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" Margin="6,2,0,0" />
                                <TextBlock Text="{Binding TagText}" FontSize="9"
                                           Foreground="{DynamicResource TextMuted}" Margin="6,2,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding PriceText}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding ChangeAmtText}" Tag="{Binding DirectionText}"
                                           Style="{StaticResource DirectionText}" FontSize="10" Margin="6,5,0,0" />
                                <TextBlock Text="{Binding ChangePctText}" Tag="{Binding DirectionText}"
                                           Style="{StaticResource DirectionText}" FontSize="10" Margin="4,5,0,0" />
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,6,0,5" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="18" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="昨收" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding PrevCloseText}" FontSize="9.5"
                                               Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="今开" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding OpenText}" FontSize="9.5"
                                               Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="最高" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding HighText}" FontSize="9.5"
                                               Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="最低" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding LowText}" FontSize="9.5"
                                               Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="月初至今" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding MtdPctText}" Tag="{Binding MtdDirectionText}"
                                               Style="{StaticResource DirectionText}" FontSize="9.5" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="年初至今" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding YtdPctText}" Tag="{Binding YtdDirectionText}"
                                               Style="{StaticResource DirectionText}" FontSize="9.5" Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="持仓" FontSize="9.5" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding PositionQtyText}" FontSize="9.5"
                                           Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                                <TextBlock Text="成本" FontSize="9.5" Foreground="{DynamicResource TextMuted}" Margin="14,0,0,0" />
                                <TextBlock Text="{Binding PositionCostText}" FontSize="9.5"
                                           Foreground="{DynamicResource TextPrimary}" Margin="5,0,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="{Binding StateText}" FontSize="8.5" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding UpdatedText}" FontSize="8.5"
                                           Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding TagText}" FontSize="9"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="3,0,3,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxWidth="156"
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding SessionText}" FontSize="9"
                               Foreground="{DynamicResource TextMuted}" Margin="2,1,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSessionText, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding Code}" FontSize="9"
                               Foreground="{DynamicResource TextMuted}" Margin="2,1,0,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding DataContext.ShowCode,
                                   RelativeSource={RelativeSource AncestorType=Window},
                                   Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding PriceText}" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextAlignment="Right" MinWidth="42" Margin="0,0,4,0" />

                <TextBlock Grid.Column="3" Text="{Binding ChangePctText}"
                           Tag="{Binding DirectionText}" Style="{StaticResource DirectionText}"
                           FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                           VerticalAlignment="Center" TextAlignment="Right" MinWidth="44" />
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!-- No card, no border: only the text is painted.
         The 1/255 alpha backdrop is invisible but makes the whole panel draggable
         (a fully transparent layered window is click-through per pixel). -->
    <Border x:Name="Root" Background="#01000000" CornerRadius="12"
            Padding="0,2,0,4" MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid Effect="{DynamicResource TextShadow}">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= header: title + quick actions ================= -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="STOCKPIN" Margin="6,0,0,0" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="HeaderButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="LockButton" Style="{StaticResource PanelIconButton}"
                            Click="Lock_Click" ToolTip="固定面板位置">
                        <TextBlock x:Name="LockGlyph" Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12.5" />
                    </Button>
                    <Button Style="{StaticResource PanelIconButton}" Click="Refresh_Click" ToolTip="立即刷新">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource PanelIconButton}" Click="Add_Click" ToolTip="添加股票">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource PanelIconButton}" Click="Settings_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </Button>
                    <Button Style="{StaticResource PanelIconButton}" Click="Hide_Click" ToolTip="隐藏到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= compact simulated portfolio (one line) ================= -->
            <Grid Grid.Row="1" Margin="11,5,11,5" ToolTip="{Binding FxTooltip}"
                  Visibility="{Binding HasPortfolio, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="持仓" FontSize="9" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding PortfolioValueText}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="今日" FontSize="9" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding TodayPlText}" Tag="{Binding TodayPctDirection}"
                               Style="{StaticResource DirectionText}" FontSize="11.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TodayPctText}" Tag="{Binding TodayPctDirection}"
                               Style="{StaticResource DirectionText}" FontSize="9" Margin="4,1,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- ================= watch list ================= -->
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="StockScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                    <ItemsControl ItemsSource="{Binding DisplayGroups}" Margin="7,0,7,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding TopMargin}">
                                    <StackPanel Orientation="Horizontal" Height="22" Margin="0,0,0,1">
                                        <Border CornerRadius="9" Background="{DynamicResource ChipBg}"
                                                Padding="7,2" VerticalAlignment="Center"
                                                Visibility="{Binding ShowSector, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Sector.Name}" FontSize="9.5"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           MaxWidth="105" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Sector.ChangePctText}"
                                                           Tag="{Binding Sector.DirectionText}"
                                                           Style="{StaticResource DirectionText}"
                                                           FontSize="9.5" Margin="5,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border Visibility="{Binding DataContext.ShowIndices,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}">
                                            <ItemsControl ItemsSource="{Binding Board.Indices}"
                                                          VerticalAlignment="Center" Margin="7,0,0,0"
                                                          Visibility="{Binding ShowBoard, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Name}" FontSize="9"
                                                                       Foreground="{DynamicResource TextMuted}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PriceText}" FontSize="9"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       Margin="4,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasPrice, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding ChangePctText}"
                                                                       Tag="{Binding DirectionText}"
                                                                       Style="{StaticResource DirectionText}"
                                                                       FontSize="9" Margin="4,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Stocks}"
                                                  ItemTemplate="{StaticResource StockRowTemplate}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,24"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="自选列表还是空的" FontSize="11" Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Center" />
                    <Button Content="＋ 添加股票" Style="{StaticResource PrimaryButton}" Height="30"
                            Width="112" Margin="0,10,0,0" Click="Add_Click" />
                </StackPanel>
            </Grid>

            <!-- ================= status line ================= -->
            <Border Grid.Row="3" Margin="11,2,11,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
