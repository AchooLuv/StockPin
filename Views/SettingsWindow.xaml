<Window x:Class="StockPin.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPin 设置"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="760" Height="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="2,16,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,7,0,0" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="16" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Grid Grid.Row="0" Margin="18,0,10,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-icon.png" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="StockPin" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="设置" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                               Margin="7,1,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Close_Click" ToolTip="关闭">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </Grid>

            <!-- ================= tabs ================= -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="18,0,18,4">
                <RadioButton x:Name="TabWatch" Style="{StaticResource PillRadio}" Content="自选股票"
                             IsChecked="True" Tag="0" Checked="Tabs_Checked" />
                <RadioButton x:Name="TabLook" Style="{StaticResource PillRadio}" Content="外观"
                             Tag="1" Checked="Tabs_Checked" Margin="6,0,0,0" />
                <RadioButton x:Name="TabGeneral" Style="{StaticResource PillRadio}" Content="通用"
                             Tag="2" Checked="Tabs_Checked" Margin="6,0,0,0" />
            </StackPanel>

            <!-- ================= content ================= -->
            <Grid Grid.Row="2" Margin="18,0,18,0">

                <!-- watch list -->
                <Grid x:Name="PaneWatch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="AddBox" Style="{StaticResource InputBox}" Height="36" FontSize="12.5"
                                     KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged" />
                            <TextBlock x:Name="AddPlaceholder"
                                       Text="请输入股票代码或名称"
                                       FontSize="12.5" Foreground="{DynamicResource TextMuted}" Opacity="0.75"
                                       Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button Grid.Column="1" Content="添加" Style="{StaticResource PrimaryButton}"
                                Width="76" Height="36" Margin="8,0,0,0" Click="Add_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                        <TextBlock x:Name="AddStatus" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Visibility="Collapsed" Margin="2,2,0,4" />
                        <Border x:Name="ResultPanel" Visibility="Collapsed" CornerRadius="9"
                                Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1" Padding="4" Margin="0,0,0,4">
                            <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ResultList" ItemsSource="{Binding Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ListRowButton}" Tag="{Binding}"
                                                    Click="Result_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="17" Height="17" CornerRadius="4"
                                                            Background="{DynamicResource ChipBg}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Tag}" FontSize="9"
                                                                   Foreground="{DynamicResource ChipText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Code}" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="6,0,6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="股票" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                        <TextBlock Grid.Column="3" Text="数量" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   TextAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="成本价" FontSize="10.5" Foreground="{DynamicResource TextMuted}"
                                   TextAlignment="Center" />
                    </Grid>

                    <ListBox x:Name="StockList" Grid.Row="3" ItemsSource="{Binding Stocks}" Background="Transparent"
                             BorderThickness="0" SelectionMode="Single" AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             DragOver="StockList_DragOver" Drop="StockList_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource RowHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Surface}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="Transparent" Cursor="SizeNS"
                                            ToolTip="拖动排序，或在面板右键里上下移动"
                                            PreviewMouseLeftButtonDown="Handle_PreviewMouseLeftButtonDown"
                                            MouseMove="Handle_MouseMove">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                                <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TextMuted}" Margin="1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Width="17" Height="17" CornerRadius="4"
                                            Background="{DynamicResource ChipBg}" VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TagText}" FontSize="9"
                                                   Foreground="{DynamicResource ChipText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="7,0,6,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                        <TextBlock Text="{Binding Code}" FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}" Margin="7,1,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBox Grid.Column="3" Style="{StaticResource InputBox}" Height="26"
                                             FontSize="12" Padding="8,0" VerticalContentAlignment="Center"
                                             Margin="6,0" MaxLength="9" TextAlignment="Right"
                                             Text="{Binding QtyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="持有数量，留空表示不持仓" />

                                    <TextBox Grid.Column="4" Style="{StaticResource InputBox}" Height="26"
                                             FontSize="12" Padding="8,0" VerticalContentAlignment="Center"
                                             Margin="6,0" MaxLength="12" TextAlignment="Right"
                                             Text="{Binding CostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="成本价（该股票所在市场的原币价格）" />

                                    <Button Grid.Column="5" Style="{StaticResource IconButton}" Width="26" Height="26"
                                            Click="Remove_Click" Tag="{Binding}" ToolTip="移除">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="4" Style="{StaticResource Hint}"
                               Text="数量和成本价都填写后才会立即计入模拟持仓；成本价填买入时的原币价格（A股人民币、港股港币、美股美元），面板按实时汇率折算为人民币。" />
                </Grid>

                <!-- appearance -->
                <ScrollViewer x:Name="PaneLook" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="主题配色" Margin="2,0,0,8" />

                        <ListBox x:Name="ThemeList" ItemsSource="{Binding Themes}"
                                 SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="12" BorderThickness="2"
                                                        BorderBrush="Transparent" Margin="0,0,10,10">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{DynamicResource AccentSoft}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush"
                                                                Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="160" Height="92" CornerRadius="10" Background="{Binding Preview}"
                                            Padding="12,10">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{Binding PreviewText}" />
                                                <TextBlock Text="{Binding Note}" FontSize="10.5"
                                                           Foreground="{Binding PreviewText}" Opacity="0.7"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                <Ellipse Width="7" Height="7" Fill="{Binding PreviewSwatches[0]}"
                                                         Margin="0,0,4,0" />
                                                <Ellipse Width="7" Height="7" Fill="{Binding PreviewSwatches[1]}"
                                                         Margin="0,0,4,0" />
                                                <Ellipse Width="7" Height="7" Fill="{Binding PreviewAccent}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Style="{StaticResource Hint}" Margin="2,2,0,0"
                                   Text="主题只改变面板的底色与文字配色，涨跌固定红涨绿跌。" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="面板背景" Margin="2,22,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景强度" FontSize="12.5" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource SliderThin}"
                                    Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Margin="18,0,18,0" VerticalAlignment="Center"
                                    Value="{Binding BackdropPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding BackdropLabel}" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                                       MinWidth="38" TextAlignment="Right" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="0% 为纯文字、完全透明；玩游戏或壁纸很花时建议 60% 以上，文字更清晰。" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="显示" />
                        <CheckBox Style="{StaticResource SwitchCheck}" Content="显示股票代码"
                                  IsChecked="{Binding ShowCode, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="在股票名称后面显示代码；关闭后更简洁。整块面板都可以直接拖到任意位置。" />
                    </StackPanel>
                </ScrollViewer>

                <!-- general -->
                <ScrollViewer x:Name="PaneGeneral" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="启动" Margin="2,0,0,10" />
                        <CheckBox Style="{StaticResource SwitchCheck}" Content="开机自启"
                                  IsChecked="{Binding AutoStart, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="登录 Windows 后自动启动；写入当前用户注册表，无需管理员权限。" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="行情刷新" />
                        <StackPanel x:Name="IntervalPanel" Orientation="Horizontal">
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="1 秒"
                                         Tag="1" Checked="Interval_Checked" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="2 秒"
                                         Tag="2" Checked="Interval_Checked" Margin="6,0,0,0" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="3 秒"
                                         Tag="3" Checked="Interval_Checked" Margin="6,0,0,0" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="5 秒"
                                         Tag="5" Checked="Interval_Checked" Margin="6,0,0,0" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="10 秒"
                                         Tag="10" Checked="Interval_Checked" Margin="6,0,0,0" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="30 秒"
                                         Tag="30" Checked="Interval_Checked" Margin="6,0,0,0" />
                            <RadioButton Style="{StaticResource PillRadio}" GroupName="Interval" Content="60 秒"
                                         Tag="60" Checked="Interval_Checked" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="1 秒最灵敏；只刷新正在交易的市场，收盘后不再请求该市场的股票，开盘前 30 分钟自动恢复；全部休市时降为 60 秒心跳。" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="面板" />
                        <CheckBox Style="{StaticResource SwitchCheck}" Content="固定面板位置"
                                  IsChecked="{Binding Locked, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="也可以直接点面板右上角的别针；固定后拖动不会移动，避免误触。面板始终置顶。" />
                        <Button Content="重置面板位置" Style="{StaticResource GhostButton}" Height="30"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetPosition_Click" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="关于" />
                        <TextBlock Text="{Binding Version, StringFormat=StockPin {0}}" FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="行情来自腾讯公开接口，汇率来自新浪财经，搜索来自东方财富；均免费、无需密钥，数据可能延迟，仅供参考。" />
                        <Button Content="GitHub 项目主页" Style="{StaticResource GhostButton}" Height="30"
                                HorizontalAlignment="Left" Margin="0,12,0,10" Click="GitHub_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ================= footer ================= -->
            <Grid Grid.Row="3" Margin="18,0,18,0">
                <TextBlock Text="Windows 10 / 11 · 轻量常驻" FontSize="10.5"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <Button Content="完成" Style="{StaticResource PrimaryButton}" Width="78" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
